{
  "name": "Yongin public-data daily collector (template)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{"field": "days", "triggerAtHour": 7, "triggerAtMinute": 0}]
        }
      },
      "id": "schedule-yongin",
      "name": "Daily 07:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "command": "cd /opt/yongin-public-data-collector && .venv/bin/python -m yongin_collector daily"
      },
      "id": "execute-yongin",
      "name": "Collect raw data",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Daily 07:00": {
      "main": [[{"node": "Collect raw data", "type": "main", "index": 0}]]
    }
  },
  "active": false,
  "settings": {"timezone": "Asia/Seoul"}
}
