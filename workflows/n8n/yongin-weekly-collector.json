    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const rows = $input.all().map(item => item.json); const failed = rows.filter(r => r.status === 'failed'); const sum = key => rows.reduce((total, row) => total + Number(row[key] || 0), 0); return [{ json: { workflow_status: failed.length ? 'partial_failure' : (rows[0]?.status === 'no_targets' ? 'no_targets' : 'success'), dataset_count: rows.filter(r => r.dataset_id).length, failed_count: failed.length, baseline_count: sum('baseline_count'), added_count: sum('added_count'), modified_count: sum('modified_count'), deleted_candidate_count: sum('deleted_candidate_count'), unchanged_count: sum('unchanged_count'), results: rows.map(r => ({ dataset_id: r.dataset_id, run_id: r.run_id, status: r.status, error_code: r.error_code, change_examples: (r.change_examples || []).slice(0, 5) })) } }];"
