{
  "id": "YNGN02AnalysisV1",
  "name": "YONGIN_02_생활여가_질문분석",
  "active": true,
  "settings": {"executionOrder": "v1", "timezone": "Asia/Seoul"},
  "nodes": [
    {
      "id": "4bfed992-878a-4f70-8b1b-100000000001",
      "name": "외부 질문 받기",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 180],
      "webhookId": "yongin-analysis-v1",
      "parameters": {
        "httpMethod": "POST",
        "path": "yongin-analysis-v1",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "4bfed992-878a-4f70-8b1b-100000000002",
      "name": "질문 입력 검증",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 180],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const body = $input.first().json.body ?? {}; const question = typeof body.question === 'string' ? body.question.slice(0, 500) : ''; const conversation_id = typeof body.conversation_id === 'string' ? body.conversation_id.slice(0, 80) : null; const history = Array.isArray(body.history) ? body.history.slice(-6).filter(m => m && ['user','assistant'].includes(m.role) && typeof m.content === 'string').map(m => ({role:m.role,content:m.content.slice(0,500)})) : []; return [{json:{question,conversation_id,history}}];"
      }
    },
    {
      "id": "4bfed992-878a-4f70-8b1b-100000000003",
      "name": "허용된 분석 조회 실행",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [480, 180],
      "parameters": {
        "method": "POST",
        "url": "http://yongin-analysis:8080/v1/analyze",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ { question: $json.question, conversation_id: $json.conversation_id, history: $json.history } }}",
        "options": {"timeout": 30000}
      }
    },
    {
      "id": "4bfed992-878a-4f70-8b1b-100000000004",
      "name": "근거 포함 JSON 응답",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [720, 180],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "외부 질문 받기": {"main": [[{"node": "질문 입력 검증", "type": "main", "index": 0}]]},
    "질문 입력 검증": {"main": [[{"node": "허용된 분석 조회 실행", "type": "main", "index": 0}]]},
    "허용된 분석 조회 실행": {"main": [[{"node": "근거 포함 JSON 응답", "type": "main", "index": 0}]]}
  }
}
